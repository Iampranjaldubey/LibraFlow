# Backend environment variables. Set these in your host's secret store / dashboard.
# NEVER commit real secrets — this file only documents the keys.

# ── Database (required) ───────────────────────────────────────────────────────
# e.g. Aiven free MySQL. Connector/J uses sslMode (not ssl-mode).
DB_URL=jdbc:mysql://<host>:<port>/<database>?sslMode=REQUIRED
DB_USERNAME=avnadmin
DB_PASSWORD=your-db-password

# ── JWT (required) ────────────────────────────────────────────────────────────
# Base64, must decode to >= 32 bytes (HS256):  openssl rand -base64 48
JWT_SECRET=replace-with-a-base64-encoded-secret

# ── Frontend origin (required in production) ─────────────────────────────────
# Used for CORS, email links and post-OAuth redirects.
FRONTEND_URL=https://your-frontend.vercel.app
# Extra exact origins allowed for CORS (comma-separated, optional).
# CORS_ALLOWED_ORIGINS=https://preview.example.com

# ── Refresh-token cookie ─────────────────────────────────────────────────────
# Through the same-origin proxy over HTTPS: Secure + Lax.
# Local plain-HTTP docker compose overrides Secure=false.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=Lax

# ── Email verification ───────────────────────────────────────────────────────
# true requires working SMTP (MAIL_*). Demo deployments without SMTP: false.
APP_AUTH_REQUIRE_EMAIL_VERIFICATION=false
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@example.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=noreply@libraflow.dev

# ── Rate limiting on login/register/password-reset (per client IP) ───────────
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_AUTH_CAPACITY=10
# RATE_LIMIT_AUTH_REFILL_PER_MINUTE=10

# ── Demo data (public demo instances only) ───────────────────────────────────
# Creates admin@ / librarian@ / member@libraflow.dev + sample books.
# Boot fails fast if APP_DEMO_SEED=true and the password is < 8 chars.
APP_DEMO_SEED=false
# APP_DEMO_PASSWORD=choose-a-demo-password

# ── Google OAuth (optional — leave unset to disable Google login) ────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Must be on the FRONTEND origin (the Next.js proxy forwards it to the API),
# and registered as an Authorized redirect URI in Google Cloud Console:
# GOOGLE_REDIRECT_URI=https://your-frontend.vercel.app/login/oauth2/code/google

# ── JVM / server ─────────────────────────────────────────────────────────────
# PORT is injected by the platform; local default 8080.
# JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
