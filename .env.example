# Local overrides for `docker compose up`. Copy to .env (git-ignored).
# Every value is optional — the compose file has working local defaults.
# For hosted deployments see backend/.env.example and docs/DEPLOYMENT.md.

# ── Database ──────────────────────────────────────────────────────────────────
DB_USERNAME=library_user
DB_PASSWORD=library_pass
MYSQL_ROOT_PASSWORD=root_pass

# ── Auth ──────────────────────────────────────────────────────────────────────
# Base64, decodes to >= 32 bytes:  openssl rand -base64 48
JWT_SECRET=
FRONTEND_URL=http://localhost:3000

# ── Demo data ─────────────────────────────────────────────────────────────────
APP_DEMO_SEED=true
APP_DEMO_PASSWORD=LibraFlow@2026

# ── Rate limiting (credential endpoints) ─────────────────────────────────────
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_REFILL_PER_MINUTE=10

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Authorized redirect URI in Google Cloud Console:
#   http://localhost:3000/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
